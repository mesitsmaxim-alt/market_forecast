# A pipeline összes curl-hívására érvényes (run_pipeline.sh: CURL_HOME=config/curl).
# Átmeneti hálózati hibánál (pl. DNS-hiba ébredés után, curl exit 6 – 2026-11-01)
# újrapróbál. A --retry-all-errors csak curl-szintű hibára hat: HTTP 404/500 nem
# curl-hiba (nincs -f), az ugyanúgy továbbmegy a fetcher saját ellenőrzéséhez.
retry = 3
retry-delay = 20
retry-all-errors
connect-timeout = 20
